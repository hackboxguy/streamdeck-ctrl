{
  "device": {
    "brightness": 80,
    "reconnect_timeout_sec": 0,
    "reconnect_interval_sec": 2,
    "layout": [2, 3]
  },
  "notification": {
    "type": "unix_socket",
    "socket_path": "/run/streamdeck-ctrl/notify.sock",
    "state_persist_path": "/tmp/streamdeck-ctrl/state.json"
  },
  "keys": [
    {
      "position": [0, 0],
      "label": "SDR/HDR Peru",
      "description": "SDR vs HDR10+ comparison stand: plays the Peru clip on both displays at once, in sync (the HDR10+ player on one, the Pi's SDR version on the other). Lit while it plays. Only on a Pi set up as that stand.",
      "icon_type": "radio",
      "icons": {
        "on": "demo-peru-on.png",
        "off": "demo-peru-off.png"
      },
      "initial_state": "off",
      "notification_id": "demo.peru",
      "action": {
        "on_press": {
          "type": "script",
          "command": "{INSTALL_DIR}/screens/display-control/scripts/sdr-hdr-demo.sh peru",
          "async": true
        }
      }
    },
    {
      "position": [0, 1],
      "label": "SDR/HDR HDR10+ Test",
      "description": "SDR vs HDR10+ comparison stand: plays the HDR10+ test clip on both displays at once, in sync (the HDR10+ player on one, the Pi's SDR version on the other). Lit while it plays. Only on a Pi set up as that stand.",
      "icon_type": "radio",
      "icons": {
        "on": "demo-test-on.png",
        "off": "demo-test-off.png"
      },
      "initial_state": "off",
      "notification_id": "demo.test",
      "action": {
        "on_press": {
          "type": "script",
          "command": "{INSTALL_DIR}/screens/display-control/scripts/sdr-hdr-demo.sh test",
          "async": true
        }
      }
    },
    {
      "position": [0, 2],
      "label": "SDR/HDR Harman",
      "description": "SDR vs HDR10+ comparison stand: plays the Harman clip on both displays at once, in sync (the HDR10+ player on one, the Pi's SDR version on the other). Lit while it plays. Only on a Pi set up as that stand.",
      "icon_type": "radio",
      "icons": {
        "on": "demo-harman-on.png",
        "off": "demo-harman-off.png"
      },
      "initial_state": "off",
      "notification_id": "demo.harman",
      "action": {
        "on_press": {
          "type": "script",
          "command": "{INSTALL_DIR}/screens/display-control/scripts/sdr-hdr-demo.sh harman",
          "async": true
        }
      }
    },
    {
      "position": [1, 0],
      "label": "Player Stop",
      "description": "Stops the video that is playing: Kodi, Dual Video or a USB Media playlist, or the SDR/HDR stand.",
      "icon_type": "static",
      "icons": {
        "default": "demo-stop.png"
      },
      "action": {
        "on_press": {
          "type": "script",
          "command": "{INSTALL_DIR}/screens/display-control/scripts/player-ctl.sh stop",
          "async": true
        }
      }
    },
    {
      "position": [1, 1],
      "label": "IP Address",
      "description": "Shows the Pi's network address (IPv4), or \"No IP!\" when it has none. Display only: pressing it does nothing.",
      "icon_type": "live_value",
      "icons": {
        "base": "ip-address.png"
      },
      "notification_id": "system.ip",
      "live": {
        "source": "poll+notify",
        "poll_command": "{INSTALL_DIR}/screens/display-control/scripts/show-ip.sh",
        "poll_interval_sec": 30,
        "format": "{value}",
        "text_anchor": "bottom",
        "text_color": "#FFFFFF",
        "font_size": 13
      },
      "action": null
    },
    {
      "position": [2, 0],
      "label": "Player -10s",
      "description": "Jumps 10 seconds back in the video that is playing.",
      "icon_type": "static",
      "icons": {
        "default": "demo-rew.png"
      },
      "action": {
        "on_press": {
          "type": "script",
          "command": "{INSTALL_DIR}/screens/display-control/scripts/player-ctl.sh seek -10",
          "async": true
        }
      }
    },
    {
      "position": [1, 2],
      "label": "Player Pause",
      "description": "Pauses the video that is playing on the current frame, or plays on. Lit while paused.",
      "icon_type": "toggle",
      "icons": {
        "on": "demo-pause-on.png",
        "off": "demo-pause-off.png"
      },
      "initial_state": "off",
      "notification_id": "player.pause",
      "state_watch": {
        "command": "{INSTALL_DIR}/screens/display-control/scripts/player-ctl.sh status",
        "text_map": {"paused": "on", "playing": "off", "none": "off"},
        "poll_interval_sec": 2
      },
      "action": {
        "on_press": {
          "type": "script",
          "command": "{INSTALL_DIR}/screens/display-control/scripts/player-ctl.sh toggle",
          "async": true
        }
      }
    },
    {
      "position": [2, 1],
      "label": "Player +10s",
      "description": "Jumps 10 seconds forward in the video that is playing.",
      "icon_type": "static",
      "icons": {
        "default": "demo-fwd.png"
      },
      "action": {
        "on_press": {
          "type": "script",
          "command": "{INSTALL_DIR}/screens/display-control/scripts/player-ctl.sh seek +10",
          "async": true
        }
      }
    },
    {
      "position": [2,  2],
      "label": "Player Loop",
      "description": "Repeats the video that is playing, over and over. Lit while repeat is on.",
      "icon_type": "toggle",
      "icons": {
        "on": "video-loop-on.bmp",
        "off": "video-loop-off.bmp"
      },
      "initial_state": "off",
      "notification_id": "player.loop",
      "state_watch": {
        "command": "{INSTALL_DIR}/screens/display-control/scripts/player-ctl.sh loop-status",
        "text_map": {"on": "on", "off": "off", "none": "off"},
        "poll_interval_sec": 2
      },
      "action": {
        "on_press": {
          "type": "script",
          "command": "{INSTALL_DIR}/screens/display-control/scripts/player-ctl.sh loop toggle",
          "async": true
        }
      }
    }
  ]
}
