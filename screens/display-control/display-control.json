{
  "device": {
    "brightness": 80,
    "reconnect_timeout_sec": 0,
    "reconnect_interval_sec": 2
  },
  "notification": {
    "type": "unix_socket",
    "socket_path": "/run/streamdeck-ctrl/notify.sock",
    "state_persist_path": "/tmp/streamdeck-ctrl/state.json"
  },
  "keys": [
    {
      "position": [0, 0],
      "label": "Home",
      "icon_type": "static",
      "icons": {
        "default": "home.bmp"
      },
      "action": {
        "on_press": {
          "type": "script",
          "command": "{INSTALL_DIR}/screens/display-control/scripts/launch-home.sh",
          "async": true
        }
      }
    },
    {
      "position": [0, 1],
      "label": "Media Player",
      "icon_type": "static",
      "icons": {
        "default": "kodi.bmp"
      },
      "action": {
        "on_press": {
          "type": "script",
          "command": "{INSTALL_DIR}/screens/display-control/scripts/launch-media-player.sh",
          "async": true
        }
      }
    },
    {
      "position": [0, 2],
      "label": "Slideshow",
      "icon_type": "static",
      "icons": {
        "default": "slideshow.bmp"
