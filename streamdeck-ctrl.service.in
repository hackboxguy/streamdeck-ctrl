# streamdeck-ctrl.service — generated by setup.sh from this template
#
# This service is NOT started at boot by default. It is started by the
# udev rule (99-streamdeck.rules) only when an Elgato Stream Deck is
# present. To start at boot regardless, run:
#   systemctl enable streamdeck-ctrl
#
[Unit]
Description=Stream Deck Control Daemon
After=multi-user.target

[Service]
Type=simple
User={USER}
Group=plugdev
WorkingDirectory={INSTALL_DIR}
Environment=PYTHONPATH={INSTALL_DIR}
ExecStart=/usr/bin/python3 {INSTALL_DIR}/streamdeck_ctrl/main.py --config={CONFIG_PATH}
# Push the real state of whatever this screen controls onto the keys at
# startup: radio keys never light themselves, so without this they come up
# blank until something else notifies them. Any sync-*.sh in the active
# screen's scripts/ runs, so a screen adds one by dropping a file in.
# NOTE the $$ escaping: systemd expands $s itself and would hand /bin/sh an
# empty word.
ExecStartPost=-/bin/sh -c 'for s in {SCREEN_DIR}/scripts/sync-*.sh; do [ -x "$$s" ] && "$$s"; done'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
RuntimeDirectory=streamdeck-ctrl
RuntimeDirectoryMode=0755

# No [Install] section — service is triggered by udev, not enabled at boot
